{
  "name": "times-grader",
  "version": "0.1.0",
  "private": true,
  "description": "Live phone-camera grading of handwritten multiplication worksheets against a teacher's key.",
  "scripts": {
    "build": "node scripts/build.mjs",
    "serve": "node scripts/build.mjs && npx --yes http-server dist -p 8080 -c-1",
    "fixtures": "python3 test/synth/make_fixtures.py",
    "test:reader": "node test/reader-accuracy.js 0 && node test/reader-accuracy.js 15",
    "test:e2e": "node scripts/build.mjs && node test/e2e-live.js",
    "train:data": "python3 training/data.py",
    "train": "python3 training/train.py"
  },
  "devDependencies": {
    "mnist": "1.1.0",
    "playwright": "^1.50.0",
    "sharp": "^0.33.0"
  }
}
